{% include "header.j2" %}
// Import together with the DB source of the same export, types first.
//
// Package centre relative to the lower-left corner of the pattern outline
// (bounding box over all package outer edges):
//   X = KxL*KL + KxB*KB + KxD*D
//   Y = KyL*KL + KyB*KB + KyD*D
// KL = long side, KB = short side of the package, D = safety gap [mm].
// The order of the packages within a pattern is NOT the placement order;
// the PLC computes the placement order itself.
// ======================================================================

TYPE "{{ names.package_type }}"
VERSION : {{ block_version }}
   STRUCT
      BaseOrientation : USInt;   // 0 = KL along pattern X, 90 = KL along pattern Y
      KxL : Real;
      KxB : Real;
      KxD : Real;
      KyL : Real;
      KyB : Real;
      KyD : Real;
   END_STRUCT;
END_TYPE

TYPE "{{ names.index_type }}"
VERSION : {{ block_version }}
   STRUCT
      PatternName : String[{{ name_length }}];   // name the MFC sends for this pattern, '' = no pattern
      FirstPackageIndex : UInt;   // first element in the flat package array, 0 = no pattern
      PackageCount : UInt;        // packages of this pattern
   END_STRUCT;
END_TYPE

